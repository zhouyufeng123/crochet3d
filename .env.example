# 复制为 .env 后按需修改

# AHOLO 开放平台 API key（必须）。也支持读系统环境变量 AHOLO_API_KEY / LUX3D_API_KEY
AHOLO_API_KEY=

# 发布给朋友访问时，设置一个口令；本地自己用留空即可
ACCESS_PASSWORD=

# 演练模式：=1 时不调用真实接口、不消耗额度（用示例模型走完整个流程）
AHOLO_MOCK=

# 重建引擎：G1（默认，效果稳定）或 G1-Turbo（更快）
LUX3D_VERSION=G1

# 目标面数（10000-300000）
LUX3D_FACE_COUNT=200000

# 监听地址与端口。0.0.0.0 表示局域网内其他设备也能访问
HOST=0.0.0.0
PORT=8000
